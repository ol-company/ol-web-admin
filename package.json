{
  "name": "ol-web-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend quản trị OL-Platform (SPA tĩnh, gọi API qua BFF cùng origin)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@mantine/core": "^8.1.3",
    "@mantine/hooks": "^8.1.3",
    "@mantine/notifications": "^8.1.3",
    "@tanstack/react-query": "^5.83.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "otpauth": "^9.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}

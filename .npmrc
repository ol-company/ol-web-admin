# Package có scope @ol-company lấy từ GitHub Packages; còn lại lấy từ npmjs.org
@ol-company:registry=https://npm.pkg.github.com
# Token đọc từ biến môi trường, KHÔNG ghi token vào file (local: $env:NODE_AUTH_TOKEN = gh auth token)
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# Báo lỗi nếu version Node không khớp trường "engines"
engine-strict=true
